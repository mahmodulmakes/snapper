{
  "name": "snapper",
  "version": "0.0.1",
  "private": true,
  "description": "Snapper — a fast, local-only screenshot tool for macOS.",
  "author": "",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "build:preloads": "node scripts/buildPreloads.mjs",
    "dev": "npm run build:preloads && electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:preloads",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
